  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "El ingeniero en computaci\xF3n realizar\xE1 el dise\xF1o y desarrollo
    de software, para dispositivos digitales y sus interfaces de usuario, adem\xE1s
    ser\xE1 especialista en el desarrollo de sistemas embebidos teniendo como base
    principios te\xF3ricos, aspectos pr\xE1cticos y metodol\xF3gicos. Ser\xE1 capaz
    de generar nueva tecnolog\xEDa y de implementar soluciones eficientes de c\xF3mputo
    en las organizaciones."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
